{
  "name": "calens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Banner class schedule to .ics, entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:b",
    "build:site": "vite build",
    "build:b": "vite build --config vite.b.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
