{
  "name": "calens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Banner class schedule to .ics, entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:b && npm run verify",
    "build:site": "vite build",
    "build:b": "vite build --config vite.b.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "verify": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
